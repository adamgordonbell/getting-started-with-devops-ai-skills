{
  "name": "Getting Started with DevOps AI Skills",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/python:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "helm": "latest",
      "kubectl": "latest",
      "minikube": "none"
    },

    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/dirien/devcontainer-feature-codex/codex:0": {},
    "ghcr.io/dirien/devcontainer-feature-pulumi/pulumi:0": {}
  },

  "postStartCommand": {
    "fix-claude-perms": "sudo chown -R vscode:vscode /home/vscode/.claude || true",
    "seed-sessions": "bash -c 'sleep 2; bash .devcontainer/seed-sessions.sh \"$PWD\"' || true",
    // setsid, so the daemon lands in its own session and outlives the exec that
    // started it; absolute path, so it doesn't depend on PATH in a login shell.
    "ccview": "bash -c 'pgrep -x ccview >/dev/null || { setsid nohup /go/bin/ccview >/tmp/ccview.log 2>&1 </dev/null & }; sleep 1; pgrep -x ccview >/dev/null && echo \"ccview up on ${CC_SERVE_PORT:-42425}\" || echo \"ccview FAILED — see /tmp/ccview.log\"' || true"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh ${containerWorkspaceFolder}",

  "forwardPorts": [19999, 3030, 42425],
  "portsAttributes": {
    "19999": { "label": "Claude Code OAuth" },
    "3030": { "label": "Slidev deck" },
    "42425": { "label": "ccview — Claude Code sessions" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },

  "containerEnv": {
    "NODE_OPTIONS": "--dns-result-order=ipv4first",
    // 42425, not ccview's default 42424: a host may already run its own viewer
    // there, and a colliding forward makes the statusline link open the host's
    // sessions instead of this container's.
    "CC_SERVE_PORT": "42425"
  },

  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "PULUMI_ACCESS_TOKEN": "${localEnv:PULUMI_ACCESS_TOKEN}"
  },

  "mounts": ["source=devops-ai-skills-claude-config,target=/home/vscode/.claude,type=volume"],

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "pulumi.pulumi-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
